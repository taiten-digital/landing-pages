---
import { Image } from 'astro:assets';
import Icon from '../../../shared/components/Icon.astro';
import treinoImg from '../assets/images/hero-treino.webp';
import forcaImg from '../assets/images/diferenciais-forca.webp';
import onlineImg from '../assets/images/consultoria-online.jpg';
import emagrecimentoImg from '../assets/images/treino-emagrecimento.jpg';

// consultoria-online.jpg and treino-emagrecimento.jpg: free-license stock
// (Unsplash License — free for commercial use, no attribution required),
// used only for these two generic/thematic cells where no real client
// photo exists yet. Every photo of Talita or her actual students elsewhere
// on this page is real; these two are clearly generic stock, not
// presented as depicting her or a specific client.

// Order is deliberate, not left to default reflow: "Avaliação física"
// leads (the natural first-read item, ties back to the page's one CTA),
// then in-person (primary segment), then the four secondary-segment lines.
// All 6 cells render at the same size (client's explicit instruction) —
// "Avaliação física" keeps priority via position and an accent border,
// not via being physically larger.
const services = [
  {
    title: 'Avaliação física',
    body: 'O ponto de partida de qualquer plano. Gratuita e sem compromisso.',
    icon: 'clipboard-check' as const,
    photo: forcaImg,
    featured: true,
  },
  {
    title: 'Atendimento presencial',
    body: 'Em domicílio, em condomínio ou em estúdio parceiro, conforme sua conveniência.',
    icon: 'dumbbell' as const,
  },
  {
    title: 'Consultoria online',
    body: 'Acompanhamento e plano de treino à distância, para quem já treina com autonomia.',
    icon: 'monitor' as const,
    photo: onlineImg,
  },
  {
    title: 'Treino de hipertrofia',
    body: 'Prescrição individualizada para ganho de força e massa muscular.',
    icon: 'dumbbell' as const,
  },
  {
    title: 'Treino para emagrecimento',
    body: 'Prescrição individualizada com foco em perda de peso.',
    icon: 'heart' as const,
    photo: emagrecimentoImg,
  },
  {
    title: 'Planilha de treino para corredores',
    body: 'Plano estruturado para quem corre, do iniciante ao mais experiente.',
    icon: 'activity' as const,
  },
];
---
<section class="services-section" id="servicos">
  <div class="services-inner">
    <div class="services-header">
      <div>
        <h2>Serviços</h2>
        <p class="services-intro">
          Além do treino especializado em coluna para 50+, atendimento para outros objetivos.
          Treino individualizado, seja qual for o seu ponto de partida.
        </p>
      </div>
      <Image
        src={treinoImg}
        alt="Treino funcional orientado pela Talita Lopes"
        width={480}
        height={360}
        loading="lazy"
        class="services-photo"
      />
    </div>
    <div class="bento">
      {services.map((s) => (
        <article
          class={`bento-cell${s.photo ? ' bento-photo-cell' : ''}${s.featured ? ' bento-featured' : ''}`}
        >
          {s.photo && (
            <Image src={s.photo} alt="" width={500} height={500} loading="lazy" class="bento-bg-photo" />
          )}
          {!s.photo && <span class="bento-icon-watermark" aria-hidden="true"><Icon name={s.icon} size={72} strokeWidth={1.5} /></span>}
          <span class="bento-icon"><Icon name={s.icon} size={22} /></span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .services-section {
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-sage) 40%, transparent) 0%, var(--color-bg) 26rem);
    padding-block: var(--space-6);
  }
  .services-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .services-header {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  .services-intro {
    color: var(--color-muted);
    margin-top: var(--space-2);
    max-width: 60ch;
  }
  .services-photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  @media (min-width: 768px) {
    .services-header {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .bento-icon {
    display: inline-flex;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
    transition: transform 200ms var(--ease-out, ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .bento-cell:hover .bento-icon {
      transform: scale(1.15) rotate(-4deg);
    }
  }
  .bento {
    /* All 6 cells the same size — client's explicit instruction. Priority
       for "Avaliação física" comes from list order + the accent border
       below, not from a bigger footprint. */
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .bento-cell {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 190px;
    transition: box-shadow 200ms var(--ease-out, ease-out), border-color 200ms var(--ease-out, ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .bento-cell:hover {
      box-shadow: 0 14px 28px -14px rgb(0 0 0 / 0.22);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Continuous gentle float, each card on its own timing so the grid
       never all moves in unison (that reads as robotic/mechanical rather
       than alive). This owns `transform` on the card itself, which is why
       hover feedback above uses box-shadow instead of the shared
       [data-hover-lift] utility's translateY — the two would otherwise
       fight over the same property every animation frame. */
    .bento-cell {
      animation: bento-float 5s ease-in-out infinite;
    }
    .bento-cell:nth-child(1) { animation-duration: 4.8s; animation-delay: 0s; }
    .bento-cell:nth-child(2) { animation-duration: 5.6s; animation-delay: 0.4s; }
    .bento-cell:nth-child(3) { animation-duration: 5.1s; animation-delay: 0.9s; }
    .bento-cell:nth-child(4) { animation-duration: 6.2s; animation-delay: 0.2s; }
    .bento-cell:nth-child(5) { animation-duration: 4.4s; animation-delay: 1.1s; }
    .bento-cell:nth-child(6) { animation-duration: 5.8s; animation-delay: 0.6s; }
  }
  @keyframes bento-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  .bento-cell::after {
    /* Clean accent-line sweep on hover — no icon/photo required, works on
       every cell including the plain (non-photo) ones. */
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0;
    background: linear-gradient(90deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 40%, white));
    transition: width 260ms var(--ease-out, ease-out);
    z-index: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .bento-cell:hover::after {
      width: 100%;
    }
  }
  .bento-cell h3 {
    position: relative;
    margin: 0;
  }
  .bento-cell p {
    position: relative;
    color: var(--color-muted);
    margin-top: var(--space-2);
  }
  .bento-icon-watermark {
    position: absolute;
    right: -0.5rem;
    bottom: -0.5rem;
    color: var(--color-accent);
    opacity: 0.08;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bento-icon-watermark {
      /* Small amplitude, slow — this sits behind persistently-visible
         content, so it needs to read as ambient texture, not motion that
         competes for attention. */
      animation: bento-watermark-wobble 9s ease-in-out infinite;
    }
  }
  @keyframes bento-watermark-wobble {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(5deg); }
  }
  .bento-bg-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .bento-photo-cell {
    /* Shared treatment for every photo-backed cell (not just the featured
       one): accent-green border + dark neutral scrim (never a green tint
       in the wash itself, per the client's "quase zero verde" note) +
       light text/icon on top. */
    color: var(--color-bg);
    border-color: var(--color-accent);
    border-width: 2px;
  }
  .bento-photo-cell::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      110deg,
      color-mix(in srgb, var(--color-forest) 94%, transparent) 45%,
      color-mix(in srgb, var(--color-forest) 55%, transparent) 100%
    );
  }
  .bento-photo-cell p {
    color: color-mix(in srgb, var(--color-bg) 80%, transparent);
  }
  .bento-photo-cell .bento-icon {
    color: var(--color-bg);
  }
  .bento-photo-cell .bento-icon,
  .bento-photo-cell h3,
  .bento-photo-cell p {
    position: relative;
    z-index: 1;
  }
</style>
