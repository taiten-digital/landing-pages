---
export interface Props {
  brand: string;
  year?: number;
}
const { brand, year = new Date().getFullYear() } = Astro.props;
---
<footer class="container" style="padding-block: var(--space-5); border-top: 1px solid var(--color-border); color: var(--color-muted);">
  <p>&copy; {year} {brand}. All rights reserved.</p>
</footer>
