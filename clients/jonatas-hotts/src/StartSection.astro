---
import CtaButton from '../../../shared/components/CtaButton.astro';
import Icon from '../../../shared/components/Icon.astro';

export interface Props {
  whatsappUrl: string;
}
const { whatsappUrl } = Astro.props;

const steps = [
  'Você manda mensagem no WhatsApp.',
  'Vocês conversam sobre o que você quer treinar, sua rotina e onde você está agora.',
  'O Jonatas monta um plano (presencial ou online) a partir disso.',
];
---
<section class="start-section" id="comeca">
  <div class="start-inner">
    <h2 class="enter enter-1">Como começa</h2>

    <!--
      A vertical connected timeline, not a card row (section 2 already owns
      that layout family) and not a stepper (design-direction.md is explicit:
      these three steps aren't timed/sequential enough to earn an
      auto-advancing mechanic - inventing one would be decoration bolted
      beside the content, the exact thing root CLAUDE.md's motion section
      warns against). The connecting line + numbered sticker nodes are still
      a distinct visual mechanism from every other section on the page.
    -->
    <ol class="start-timeline">
      {steps.map((step, i) => (
        <li class={`start-step enter enter-${i + 2}`}>
          <span
            class="start-step-num idle-float"
            style={`--float-duration:${4.6 + i * 0.4}s; --float-delay:${i * 0.3}s;`}
          >{i + 1}</span>
          <p>{step}</p>
        </li>
      ))}
    </ol>

    <p class="enter enter-5 start-reassurance">
      A primeira mensagem não é compromisso nenhum. É só pra entender o que
      você precisa e ver se faz sentido pra você.
    </p>
    <p class="enter enter-5 start-pricing">
      Valores, frequência e detalhes do plano são combinados direto na
      conversa: não tem tabela fixa, porque o treino é montado pro que você
      precisa.
    </p>

    <div class="enter enter-6 start-cta">
      <CtaButton href={whatsappUrl} variant="primary" external pulse>
        <Icon name="whatsapp" size={18} />
        Agendar avaliação
      </CtaButton>
    </div>
  </div>
</section>
<style>
  .start-section {
    background: var(--color-bg);
    padding-block: var(--space-6);
  }
  .start-inner {
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .start-timeline {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    position: relative;
  }
  .start-timeline::before {
    content: '';
    position: absolute;
    left: 1.35rem;
    top: 1rem;
    bottom: 1rem;
    width: 3px;
    background: repeating-linear-gradient(
      to bottom,
      var(--color-border) 0,
      var(--color-border) 6px,
      transparent 6px,
      transparent 12px
    );
    /* Lets the section's own real mechanic (a sequential process) carry
       motion instead of an unrelated decoration - 12px matches the gradient's
       own repeat unit above so the loop is seamless. */
    animation: timeline-flow 1.4s linear infinite;
  }
  @keyframes timeline-flow {
    to { background-position: 0 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .start-timeline::before {
      animation: none;
    }
  }
  .start-step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }
  .start-step-num {
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    background: var(--color-energy);
    color: var(--color-charcoal);
    border: var(--border-sticker);
    box-shadow: var(--shadow-sticker);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.1rem;
  }
  .start-step p {
    margin-top: var(--space-1);
    padding-top: 0.5rem;
  }

  .start-reassurance {
    margin-top: var(--space-5);
    font-weight: 700;
  }
  .start-pricing {
    margin-top: var(--space-2);
    color: var(--color-muted);
  }
  .start-cta {
    margin-top: var(--space-4);
  }
</style>
