---
import CtaButton from '../../../shared/components/CtaButton.astro';
import Icon from '../../../shared/components/Icon.astro';

const WHATSAPP_URL =
  'https://wa.me/5543984795883?text=' +
  encodeURIComponent('Olá, Talita! Vi sua página e quero marcar uma avaliação gratuita.');

const socials = [
  { icon: 'whatsapp' as const, label: '(43) 98479-5883', href: WHATSAPP_URL, external: true },
  { icon: 'instagram' as const, label: '@talitalopes.personal', href: 'https://www.instagram.com/talitalopes.personal/', external: true },
  { icon: 'mail' as const, label: 'talitalopes.personal@gmail.com', href: 'mailto:talitalopes.personal@gmail.com', external: false },
];

const steps = [
  { title: 'Chame no WhatsApp', body: 'Conte seu objetivo ou desconforto.', icon: 'whatsapp' as const },
  {
    title: 'Marque sua avaliação gratuita',
    body: 'Talita entende seu histórico e suas limitações antes de qualquer treino.',
    icon: 'clipboard-check' as const,
  },
  {
    title: 'Receba seu plano personalizado',
    body: 'Treino pensado para você, que se adapta conforme você evolui.',
    icon: 'activity' as const,
  },
];
---
<section class="process-section" id="contato">
  <div class="process-inner">
    <h2>Como funciona</h2>
    <p class="process-intro">Três passos, sem burocracia.</p>

    <!--
      Rebuilt from zero: the old static 3-card row + a decorative dot
      traveling on an unrelated track (motion disconnected from the actual
      content) became an auto-advancing stepper — a fill bar under the
      active tab counts down in real time and the spotlight moves to the
      next real step when it completes, so the motion IS the content this
      time, not decoration next to it. Manual tab clicks work too and
      reset the timer; hover/focus pauses it. Reduced-motion disables
      auto-advance and the fill animation entirely (manual tabs still work).
    -->
    <div class="stepper" data-stepper>
      <div class="stepper-tabs" role="tablist" aria-label="Como funciona, passo a passo">
        {steps.map((step, i) => (
          <button type="button" class="stepper-tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab-index={i}>
            <span class="stepper-tab-icon"><Icon name={step.icon} size={20} /></span>
            <span class="stepper-tab-label">{step.title}</span>
            <span class="stepper-tab-fill" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <div class="stepper-panel">
        {steps.map((step, i) => (
          <div class="stepper-panel-item" data-panel-index={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <span class="stepper-panel-index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="talk-section">
      <h2>Fale com a Talita</h2>
      <p class="talk-intro">Sem compromisso. Sem cartão. Sem letra miúda.</p>

      <!--
        Rebuilt from zero: a plain "heading + button" CTA became a chat-
        composer mockup — the exact message that actually gets sent when
        you tap it, shown as if you were about to send it. Ties back to
        the conversational language already used in "Sobre a Talita" ("Ela
        ouve") and the FAQ's chat-bubble thread instead of introducing a
        fourth, unrelated CTA pattern.
      -->
      <div class="talk-card">
        <div class="talk-glow" aria-hidden="true"></div>
        <div class="talk-header">
          <span class="talk-avatar" aria-hidden="true">T</span>
          <div>
            <p class="talk-name">Talita Lopes</p>
            <p class="talk-status">Ela mesma responde</p>
          </div>
        </div>
        <p class="talk-bubble">“Olá, Talita! Vi sua página e quero marcar uma avaliação gratuita.”</p>
        <span class="talk-typing" aria-hidden="true"><span></span><span></span><span></span></span>
        <div class="talk-send-wrap">
          <CtaButton href={WHATSAPP_URL} variant="primary" external>
            <span class="talk-send-inner"><Icon name="whatsapp" size={18} />Enviar mensagem</span>
          </CtaButton>
        </div>
      </div>

      <div class="contact-alt">
        <span class="contact-alt-label">ou fale por</span>
        <div class="contact-alt-links">
          {socials.map((s) => (
            <a
              href={s.href}
              target={s.external ? '_blank' : undefined}
              rel={s.external ? 'noopener noreferrer' : undefined}
              class="contact-alt-link"
            >
              <Icon name={s.icon} size={16} />{s.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((stepper) => {
    const tabs = Array.from(stepper.querySelectorAll<HTMLButtonElement>('.stepper-tab'));
    const panels = Array.from(stepper.querySelectorAll<HTMLElement>('.stepper-panel-item'));
    if (!tabs.length) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;
    let timer: number | undefined;

    const setActive = (i: number) => {
      active = i;
      tabs.forEach((t, idx) => {
        t.setAttribute('aria-selected', idx === i ? 'true' : 'false');
        t.classList.toggle('is-active', idx === i);
      });
      panels.forEach((p, idx) => {
        p.setAttribute('aria-hidden', idx === i ? 'false' : 'true');
        p.classList.toggle('is-active', idx === i);
      });
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
    };
    const start = () => {
      if (reduced) return;
      stop();
      timer = window.setInterval(() => setActive((active + 1) % tabs.length), 4000);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        setActive(i);
        start();
      });
    });
    stepper.addEventListener('mouseenter', stop);
    stepper.addEventListener('mouseleave', start);
    stepper.addEventListener('focusin', stop);
    stepper.addEventListener('focusout', start);

    setActive(0);
    start();
  });
</script>
<style>
  .process-section {
    background: var(--color-forest);
    color: var(--color-bg);
    padding-block: var(--space-6);
  }
  .process-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
    text-align: center;
  }
  .process-intro {
    color: var(--color-muted-dark);
    margin-top: var(--space-2);
  }

  /* Stepper */
  .stepper {
    margin-top: var(--space-5);
    text-align: left;
  }
  .stepper-tabs {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 640px) {
    .stepper-tabs {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .stepper-tab {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--color-bg) 16%, transparent);
    background: color-mix(in srgb, var(--color-bg) 5%, transparent);
    color: var(--color-bg);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 200ms var(--ease-out, ease-out), background-color 200ms var(--ease-out, ease-out);
  }
  .stepper-tab.is-active {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
  }
  .stepper-tab-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .stepper-tab-label {
    font-weight: 700;
    font-size: 0.9rem;
  }
  .stepper-tab-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 0%;
    background: var(--color-accent);
  }
  .stepper-tab.is-active .stepper-tab-fill {
    animation: stepper-fill 4s linear forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .stepper-tab.is-active .stepper-tab-fill {
      animation: none;
      width: 100%;
    }
  }
  @keyframes stepper-fill {
    from { width: 0%; }
    to { width: 100%; }
  }
  .stepper-panel {
    margin-top: var(--space-4);
  }
  .stepper-panel-item {
    display: none;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-bg) 12%, transparent);
  }
  .stepper-panel-item.is-active {
    display: block;
  }
  .stepper-panel-index {
    font-family: var(--font-display, inherit);
    font-weight: 800;
    color: var(--color-accent);
    font-size: 1.5rem;
    line-height: 1;
  }
  .stepper-panel-item h3 {
    margin: var(--space-1) 0 0;
  }
  .stepper-panel-item p {
    margin-top: var(--space-1);
    color: var(--color-muted-dark);
  }

  /* Talk composer */
  .talk-section {
    margin-top: var(--space-6);
  }
  .talk-intro {
    color: var(--color-muted-dark);
    margin-top: var(--space-2);
  }
  .talk-card {
    position: relative;
    overflow: hidden;
    margin-top: var(--space-5);
    max-width: 26rem;
    margin-inline: auto;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-bg) 16%, transparent);
    text-align: left;
  }
  .talk-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22rem;
    height: 22rem;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 22%, transparent) 0%, transparent 60%);
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
  }
  .talk-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .talk-avatar {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-fg);
    font-family: var(--font-display, inherit);
    font-weight: 800;
  }
  .talk-name {
    font-weight: 700;
  }
  .talk-status {
    font-size: 0.8rem;
    color: var(--color-muted-dark);
  }
  .talk-bubble {
    position: relative;
    z-index: 1;
    margin: var(--space-3) 0 0;
    background: var(--color-accent);
    color: var(--color-accent-fg);
    padding: var(--space-3) var(--space-4);
    border-radius: 1.1rem;
    border-bottom-left-radius: 0.3rem;
    font-weight: 600;
    font-size: 0.95rem;
    max-width: 90%;
  }
  .talk-typing {
    position: relative;
    z-index: 1;
    display: inline-flex;
    gap: 0.3rem;
    margin: var(--space-3) 0 0 var(--space-1);
  }
  .talk-typing span {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-bg) 50%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .talk-typing span {
      animation: talk-typing-bounce 1.2s ease-in-out infinite;
    }
    .talk-typing span:nth-child(2) { animation-delay: 0.15s; }
    .talk-typing span:nth-child(3) { animation-delay: 0.3s; }
  }
  @keyframes talk-typing-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-4px); opacity: 1; }
  }
  .talk-send-wrap {
    position: relative;
    z-index: 1;
    margin-top: var(--space-4);
  }
  .talk-send-wrap :global(.cta-button) {
    width: 100%;
    justify-content: center;
  }
  .talk-send-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .contact-alt {
    margin-top: var(--space-5);
    text-align: center;
  }
  .contact-alt-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted-dark);
  }
  .contact-alt-links {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .contact-alt-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-bg);
    text-decoration: none;
    padding: 0.5em 1em;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--color-bg) 18%, transparent);
    transition: border-color 160ms var(--ease-out, ease-out), background-color 160ms var(--ease-out, ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-alt-link:hover {
      border-color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    }
  }
  .contact-alt-link :global(svg) {
    color: var(--color-accent);
  }
</style>
