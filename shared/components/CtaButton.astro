---
export interface Props extends Omit<astroHTML.JSX.AnchorHTMLAttributes, 'href'> {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  // Subtle idle pulse+glow loop — opt-in, off by default. Meant for the
  // one most prominent CTA on a page (e.g. the Hero's), not every button,
  // so it reads as "this is the one to click" rather than noisy repetition.
  pulse?: boolean;
}
const { href, variant = 'primary', external = false, pulse = false, ...rest } = Astro.props;
---
<a
  {...rest}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class={`cta-button cta-button--${variant}${pulse ? ' cta-button--pulse' : ''}`}
>
  <slot />
</a>
<style>
  .cta-button {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
    min-height: 44px;
    transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
  }
  .cta-button--primary {
    background: var(--color-accent);
    color: var(--color-accent-fg);
    border: none;
  }
  .cta-button--secondary {
    background: transparent;
    color: var(--color-fg);
    border: 1px solid var(--color-border);
  }
  .cta-button:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .cta-button--primary:hover {
      transform: translateY(-2px);
      box-shadow:
        0 4px 10px -2px color-mix(in srgb, var(--color-accent) 50%, transparent),
        0 0 32px 4px color-mix(in srgb, var(--color-accent) 45%, transparent);
    }
  }
  @keyframes cta-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 45%, transparent);
    }
    50% {
      box-shadow: 0 0 0 10px color-mix(in srgb, var(--color-accent) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .cta-button--pulse {
      animation: cta-pulse 2.4s ease-in-out infinite;
    }
    .cta-button--pulse:hover {
      animation-play-state: paused;
    }
  }
</style>
