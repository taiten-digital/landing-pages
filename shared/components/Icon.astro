---
// Minimal inline SVG icon set — zero dependency, opt-in, stroke-based
// (currentColor), 24x24 viewBox. Add a new `case` only when a real need
// exists; don't pre-build an icon library nobody's using yet.
export interface Props {
  name:
    | 'check'
    | 'chevron-left'
    | 'chevron-right'
    | 'chevron-down'
    | 'menu'
    | 'close'
    | 'whatsapp'
    | 'dumbbell'
    | 'monitor'
    | 'activity'
    | 'clipboard-check'
    | 'heart'
    | 'quote'
    | 'star'
    | 'instagram'
    | 'mail';
  size?: number;
  strokeWidth?: number;
}
const { name, size = 20, strokeWidth = 2 } = Astro.props;
---
{name === 'check' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="20 6 9 17 4 12" />
  </svg>
)}
{name === 'chevron-left' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="15 18 9 12 15 6" />
  </svg>
)}
{name === 'chevron-right' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="9 18 15 12 9 6" />
  </svg>
)}
{name === 'chevron-down' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="6 9 12 15 18 9" />
  </svg>
)}
{name === 'menu' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" aria-hidden="true">
    <line x1="4" y1="7" x2="20" y2="7" />
    <line x1="4" y1="12" x2="20" y2="12" />
    <line x1="4" y1="17" x2="20" y2="17" />
  </svg>
)}
{name === 'close' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" aria-hidden="true">
    <line x1="5" y1="5" x2="19" y2="19" />
    <line x1="19" y1="5" x2="5" y2="19" />
  </svg>
)}
{name === 'whatsapp' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.39 1.26 4.81L2 22l5.42-1.35c1.36.72 2.9 1.13 4.55 1.13h.03c5.46 0 9.91-4.45 9.91-9.91C21.91 6.45 17.5 2 12.04 2zm5.8 14.03c-.24.68-1.4 1.3-1.93 1.36-.5.06-1.08.08-1.75-.11-.4-.12-.92-.28-1.58-.55-2.78-1.2-4.6-4-4.74-4.19-.14-.19-1.13-1.5-1.13-2.86 0-1.36.71-2.03.97-2.3.24-.28.53-.34.7-.34h.5c.16 0 .38-.03.58.44.24.57.78 1.98.85 2.13.07.14.11.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.13-.29.28-.13.55.16.28.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.24 1.38.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.55.73 1.82.86.27.14.44.2.51.32.07.11.07.66-.17 1.35z" />
  </svg>
)}
{name === 'dumbbell' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 9v6" /><path d="M2 10v4" />
    <path d="M20 9v6" /><path d="M22 10v4" />
    <path d="M6 12h12" />
    <rect x="4" y="7.5" width="3" height="9" rx="1" />
    <rect x="17" y="7.5" width="3" height="9" rx="1" />
  </svg>
)}
{name === 'monitor' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2" />
    <line x1="8" y1="20" x2="16" y2="20" />
    <line x1="12" y1="16" x2="12" y2="20" />
  </svg>
)}
{name === 'activity' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="3 12 8 12 10 6 14 18 16 12 21 12" />
  </svg>
)}
{name === 'clipboard-check' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="6" y="4" width="12" height="16" rx="2" />
    <path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1" />
    <polyline points="9 13 11 15 15 10" />
  </svg>
)}
{name === 'heart' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 20s-7-4.4-9.5-8.6C.6 8 2 4.5 5.4 4c2-.3 3.7.8 4.6 2.2C10.9 4.8 12.6 3.7 14.6 4c3.4.5 4.8 4 3.9 7.4C16 15.6 12 20 12 20z" />
  </svg>
)}
{name === 'quote' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M9.5 7C6.5 8 5 10.3 5 13c0 2 1.3 3.5 3 3.5S11 15.2 11 13.4c0-1.5-1-2.6-2.3-2.9C9 9 10.2 8 11.5 7.4L9.5 7zm9 0c-3 1-4.5 3.3-4.5 6 0 2 1.3 3.5 3 3.5s3-1.3 3-3.1c0-1.5-1-2.6-2.3-2.9C18 9 19.2 8 20.5 7.4L18.5 7z" />
  </svg>
)}
{name === 'star' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 2.5l2.9 6.1 6.6.7-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.2 1.3-6.6-4.9-4.6 6.6-.7L12 2.5z" />
  </svg>
)}
{name === 'instagram' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'mail' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <polyline points="3 7 12 13 21 7" />
  </svg>
)}
