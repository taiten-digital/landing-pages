---
export interface Props {
  eyebrow?: string;
  headline: string;
  subheadline?: string;
}
const { eyebrow, headline, subheadline } = Astro.props;
---
<section class="hero container" style="padding-block: var(--space-6);">
  {eyebrow && <p style="color: var(--color-accent); font-weight: 600;">{eyebrow}</p>}
  <h1>{headline}</h1>
  {subheadline && <p style="color: var(--color-muted); max-width: 40ch; margin-top: var(--space-3);">{subheadline}</p>}
  <div style="margin-top: var(--space-4);">
    <slot />
  </div>
</section>
