---
// Client page for "Talita Lopes" — this file's existence registers the route
// at /talita-lopes (see src/pages/[slug].astro). Composed of small
// client-local sections (below) plus shared/components where they fit.
import '@fontsource-variable/bricolage-grotesque';
// Body copy (Hanken Grotesk) is used at 400/700/800 across this page
// (eyebrow, CTA, timeline, credential markers) — import those weights
// explicitly so the browser never falls back to faux/synthetic bold.
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/hanken-grotesk/800.css';
import { Image } from 'astro:assets';
import Nav from '../../../shared/components/Nav.astro';
import logoImg from '../assets/images/logo.webp';
import HeroSection from './HeroSection.astro';
import AboutSection from './AboutSection.astro';
import TestimonialsSection from './TestimonialsSection.astro';
import ServicesSection from './ServicesSection.astro';
import FaqSection, { faqs } from './FaqSection.astro';
import ContactSection from './ContactSection.astro';

// src/pages/[slug].astro reads these named exports and forwards them to
// BaseLayout (title, description, lang, canonical, theme-color).
export const pageTitle = 'Personal Trainer em Londrina para 50+ e Coluna | Talita Lopes';
export const pageDescription =
  'Treino que se adapta a você: especialista em exercício para distúrbios da coluna, pensado para pessoas 50+ em Londrina/PR. Avaliação física gratuita, sem compromisso.';
export const pageLang = 'pt-BR';
export const pageThemeColor = '#2f9e52';

const WHATSAPP_URL =
  'https://wa.me/5543984795883?text=' +
  encodeURIComponent('Olá, Talita! Vi sua página e quero marcar uma avaliação gratuita.');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />

<Nav
  brand="Talita Lopes"
  sticky
  links={[
    { label: 'Sobre', href: '#sobre' },
    { label: 'Serviços', href: '#servicos' },
    { label: 'Depoimentos', href: '#depoimentos' },
    { label: 'FAQ', href: '#faq' },
  ]}
  cta={{ href: WHATSAPP_URL, label: 'Marcar avaliação', external: true, icon: 'whatsapp' }}
>
  <Image slot="logo-mark" src={logoImg} alt="" width={40} height={40} loading="eager" />
</Nav>
<div class="scroll-progress" aria-hidden="true"></div>
<main>
  <HeroSection />
  <AboutSection />
  <TestimonialsSection />
  <ServicesSection />
  <FaqSection />
  <ContactSection />
</main>
<footer class="site-footer">
  <p>&copy; {new Date().getFullYear()} Talita Lopes. Todos os direitos reservados.</p>
</footer>
<style>
  .site-footer {
    background: var(--color-forest);
    color: var(--color-muted-dark);
    text-align: center;
    padding-block: var(--space-4);
  }
</style>
