---
import Icon from './Icon.astro';

export interface Props {
  brand: string;
  links?: { label: string; href: string }[];
  // Optional pill CTA rendered in the nav bar. Defaults to none so clients
  // that don't pass it (every client but talita-lopes today) are unaffected.
  cta?: { href: string; label: string; external?: boolean; icon?: 'whatsapp' | 'check' };
  // Opt-in sticky-header behavior (position: sticky + scroll-state blur,
  // see shared/styles/base.css [data-sticky-nav] and BaseLayout's scroll
  // listener). Off by default so existing clients keep a plain static bar.
  sticky?: boolean;
}
const { brand, links = [], cta, sticky = false } = Astro.props;
---
<div class="nav-bar" data-sticky-nav={sticky ? true : undefined}>
  <header class="container nav-header">
    <span class="nav-brand">
      <slot name="logo-mark" />
      {brand}
    </span>

    {links.length > 0 && <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />}

    <nav class="nav-links" id="nav-links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      {cta && (
        <a
          href={cta.href}
          target={cta.external ? '_blank' : undefined}
          rel={cta.external ? 'noopener noreferrer' : undefined}
          class="cta-button cta-button--primary nav-cta"
        >
          {cta.icon && <Icon name={cta.icon} size={16} />}
          {cta.label}
        </a>
      )}
    </nav>

    {links.length > 0 && (
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
        <span class="icon-open"><Icon name="menu" /></span>
        <span class="icon-close"><Icon name="close" /></span>
      </label>
    )}
  </header>
</div>
<style>
  .nav-bar {
    /* Full-bleed background hook: transparent by default (no visual change
       for clients that don't set --nav-bg), opt-in via a client-scoped
       token, e.g. [data-client="talita-lopes"] { --nav-bg: var(--color-cream); }
       Kept on this wrapper (not .nav-header, which is width-constrained by
       .container) so the color reaches the true viewport edges. */
    background: var(--nav-bg, transparent);
  }
  .nav-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-weight: 700;
    font-family: var(--font-display, inherit);
    white-space: nowrap;
    font-size: clamp(0.95rem, 0.8rem + 0.6vw, 1.15rem);
  }
  .nav-brand :global(img) {
    height: 1.8em;
    width: auto;
  }

  .nav-toggle-input { position: absolute; opacity: 0; pointer-events: none; }

  .nav-toggle-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;
    color: inherit;
  }
  .nav-toggle-label .icon-close { display: none; }
  .nav-toggle-input:checked ~ .nav-toggle-label .icon-open { display: none; }
  .nav-toggle-input:checked ~ .nav-toggle-label .icon-close { display: inline-flex; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Mobile: links collapse into a full-width dropdown panel below the bar,
     toggled by the checkbox (zero JS). */
  @media (max-width: 767px) {
    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      order: 3;
      gap: var(--space-2);
      padding-block: var(--space-3);
      border-top: 1px solid var(--color-border);
      margin-top: var(--space-2);
    }
    .nav-links a:not(.nav-cta) {
      padding-block: var(--space-2);
      font-weight: 600;
    }
    .nav-toggle-input:checked ~ .nav-links { display: flex; }
  }

  .nav-cta {
    /* CtaButton.astro's own <style> is scoped to that file, so simply
       reusing its class names here (a plain <a>, not a rendered
       <CtaButton>) picks up none of its background/color/min-height/
       padding rules - only whatever global (non-scoped) CSS happens to
       also target .cta-button. Without these, the nav CTA rendered as
       transparent, unpadded text ~21px tall (fails the 44px touch-target
       minimum). Declared fully here so this button is self-sufficient. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-height: 44px;
    padding-block: var(--space-2);
    padding-inline: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-fg, var(--color-bg));
    font-weight: 600;
    text-decoration: none;
    font-size: 0.8rem;
    white-space: nowrap;
    transition: transform 160ms var(--ease-out, ease-out);
  }
  .nav-cta:active {
    transform: scale(0.97);
  }
  @media (min-width: 768px) {
    .nav-toggle-label { display: none; }
    .nav-links { gap: var(--space-4); }
    .nav-cta { font-size: 0.9rem; padding-inline: var(--space-4); }
  }
</style>
