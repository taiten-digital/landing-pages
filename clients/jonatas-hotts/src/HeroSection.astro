---
import { Image } from 'astro:assets';
import CtaButton from '../../../shared/components/CtaButton.astro';
import Icon from '../../../shared/components/Icon.astro';
import jonatasFoto from '../assets/images/jonatas-treino-1.jpg';

export interface Props {
  whatsappUrl: string;
}
const { whatsappUrl } = Astro.props;
---
<!--
  Real photo of Jonatas himself, sourced from his own public Instagram
  (instagram.com/jhotts, a talking-to-camera clip) and cropped with sharp
  to drop the clip's own burned-in caption text — not a stock photo
  standing in for him, this is actually him. Framed straight (no rotation)
  per client feedback that the earlier tilted photo frames read as
  crooked/careless rather than a deliberate "sticker" tilt; only small
  decorative badges/chips keep the sticker tilt now, never the photos
  themselves. Framed as a "sticker" photo card (thick outline, hard offset
  shadow) rather than a full-bleed crop, since the source is a portrait
  frame that would crop badly forced into a wide hero (root CLAUDE.md's
  full-bleed hero rule).
-->
<section class="hero-section" id="top">
  <div class="hero-glow idle-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="enter enter-1 hero-eyebrow">Personal trainer em Londrina, PR</p>
      <h1 class="enter enter-2">
        Um personal que se adapta a <span class="text-gradient-energy">você</span>, não o contrário
      </h1>
      <p class="enter enter-3 hero-sub">
        Presencial em Londrina ou online: treino pra quem quer emagrecer, ganhar
        condicionamento ou voltar a treinar depois de um tempo parado. Nada de
        treino de atleta pra quem só quer se sentir melhor no dia a dia.
      </p>
      <div class="enter enter-4 hero-cta">
        <CtaButton href={whatsappUrl} variant="primary" external pulse>
          <Icon name="whatsapp" size={18} />
          Agendar avaliação
        </CtaButton>
        <p class="hero-cta-note">Manda uma mensagem no WhatsApp e já marca sua avaliação.</p>
      </div>
    </div>

    <div class="hero-photo-wrap enter enter-5">
      <div class="hero-photo-frame card-sticker">
        <div class="hero-photo-float idle-float" style="--float-duration:6.4s; --float-delay:0.15s;">
          <Image
            src={jonatasFoto}
            alt="Jonatas Hotts, personal trainer em Londrina"
            width={480}
            loading="eager"
            fetchpriority="high"
            class="hero-photo-img"
          />
        </div>
      </div>
      <div class="hero-badge card-sticker" style="--float-duration:4.6s; --float-delay:0s;">
        <span class="hero-badge-inner idle-float">
          <Icon name="dumbbell" size={18} />
          Presencial
        </span>
      </div>
      <div class="hero-badge hero-badge-alt card-sticker" style="--float-duration:5.4s; --float-delay:0.3s;">
        <span class="hero-badge-inner idle-float">
          <Icon name="monitor" size={18} />
          Online
        </span>
      </div>
    </div>
  </div>
</section>
<style>
  .hero-section {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    background: var(--color-sand);
    /* min-height math: measured this client's actual rendered Nav.astro height
       via a throwaway Playwright script (see clients/jonatas-hotts/qa notes in
       the implementation report), not assumed - kept as an explicit token so
       it stays traceable if the nav ever changes. svh with a vh fallback so
       mobile browser chrome resizing doesn't cut the hero short. */
    min-height: calc(100vh - var(--nav-height-measured));
    min-height: calc(100svh - var(--nav-height-measured));
    padding-block: var(--space-6);
  }
  .hero-glow {
    position: absolute;
    top: 8%;
    right: -6%;
    width: 26rem;
    height: 26rem;
    background: var(--glow-energy);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
    width: 100%;
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: var(--space-6);
    }
  }
  .hero-copy {
    max-width: 36rem;
  }
  .hero-eyebrow {
    color: var(--color-energy-deep);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
  }
  .hero-section h1 {
    margin-top: var(--space-2);
  }
  .hero-sub {
    color: var(--color-muted);
    margin-top: var(--space-3);
    max-width: 46ch;
  }
  .hero-cta {
    margin-top: var(--space-4);
  }
  .hero-cta-note {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .hero-photo-wrap {
    position: relative;
    margin-top: var(--space-5);
    /* `width`, not `max-width`: this is a single-column CSS Grid item
       (.hero-inner), and the photo frame's only child is now a
       position:absolute float layer (for idle-float), which contributes
       zero intrinsic size to ancestors. Without an explicit `width` here,
       the grid's "auto" track sizing + the frame's own `aspect-ratio` with
       no definite width collapse the whole chain to ~0 (confirmed via
       direct measurement) - `max-width` alone doesn't give a block box a
       real size when nothing above or below it in the flow has intrinsic
       content anymore. */
    width: 20rem;
    max-width: 100%;
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .hero-photo-wrap {
      margin-top: 0;
      justify-self: end;
      width: 22rem;
    }
  }
  .hero-photo-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    aspect-ratio: 4 / 5;
  }
  /* Float layer is intentionally larger than the frame (inset: -10px) so the
     idle-float bob/rotate doesn't reveal the frame's edge underneath -
     .hero-photo-frame's own overflow:hidden clips the overshoot. */
  .hero-photo-float {
    position: absolute;
    inset: -10px;
  }
  .hero-photo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-badge {
    position: absolute;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
  }
  .hero-badge:first-of-type {
    top: -0.75rem;
    left: -1.25rem;
    transform: rotate(-4deg);
  }
  .hero-badge-alt {
    bottom: -0.75rem;
    right: -1rem;
    transform: rotate(3deg);
  }
  .hero-badge-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .hero-badge-inner :global(svg) {
    color: var(--color-energy-deep);
  }
</style>
