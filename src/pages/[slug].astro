---
// Creating clients/<slug>/src/index.astro IS registering the route — no
// manual routing config. Each client's own tokens.css is inlined after the
// shared base tokens so client overrides win, scoped to [data-client].
import BaseLayout from '../layouts/BaseLayout.astro';

const pageModules = import.meta.glob('/clients/*/src/index.astro');
const tokenModules = import.meta.glob('/clients/*/src/tokens.css', { query: '?raw', import: 'default' });

export async function getStaticPaths() {
  const modules = import.meta.glob('/clients/*/src/index.astro');
  return Object.keys(modules).map((filepath) => {
    const slug = filepath.split('/')[2];
    return { params: { slug }, props: { filepath } };
  });
}

const { filepath } = Astro.props;
const { slug } = Astro.params;

const mod = (await pageModules[filepath]()) as {
  default: any;
  pageTitle?: string;
  pageDescription?: string;
  pageLang?: string;
  pageThemeColor?: string;
};
const ClientPage = mod.default;

const tokensPath = `/clients/${slug}/src/tokens.css`;
const clientTokensCss = tokenModules[tokensPath] ? await tokenModules[tokensPath]() : '';
---
<BaseLayout
  title={mod.pageTitle ?? slug}
  description={mod.pageDescription}
  lang={mod.pageLang ?? 'en'}
  canonicalPath={`/${slug}`}
  themeColor={mod.pageThemeColor}
>
  {clientTokensCss && <style set:html={clientTokensCss} />}
  <div data-client={slug}>
    <ClientPage />
  </div>
</BaseLayout>
