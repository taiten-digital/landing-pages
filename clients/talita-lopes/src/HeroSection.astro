---
import { Image } from 'astro:assets';
import CtaButton from '../../../shared/components/CtaButton.astro';
import Icon from '../../../shared/components/Icon.astro';
import heroBg from '../assets/images/hero-bg-jogging.jpg';

// Full-bleed background, fourth pass (kept this round — first time the
// photo itself wasn't the complaint). Landscape source (6000x4000, 3:2):
// Pexels License, free for commercial use, no attribution required;
// generic/atmospheric, not presented as depicting Talita or any specific
// person, consistent with this project's other stock photos.
const WHATSAPP_URL =
  'https://wa.me/5543984795883?text=' +
  encodeURIComponent('Olá, Talita! Vi sua página e quero marcar uma avaliação gratuita.');
---
<section class="hero-section">
  <div class="hero-bg" data-parallax>
    <Image
      src={heroBg}
      alt=""
      width={1920}
      loading="eager"
      fetchpriority="high"
      class="hero-bg-img"
    />
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="enter enter-1 hero-eyebrow">Personal trainer em Londrina/PR</p>
      <h1 class="enter enter-2">
        O treino se adapta a{' '}
        <span class="accent-highlight">
          <span class="hero-accent-bar" aria-hidden="true"></span>
          <span class="accent-highlight-text">você</span>
        </span>. Não o contrário.
      </h1>
      <p class="enter enter-3 hero-sub">
        Especialista em coluna vertebral para pessoas 50+. Já tentou antes e não teve
        resultado, ou não se sentiu ouvido? A avaliação física é gratuita e sem compromisso.
      </p>
      <div class="enter enter-4 hero-cta">
        <CtaButton href={WHATSAPP_URL} variant="primary" external pulse>Marcar avaliação gratuita</CtaButton>
      </div>
    </div>

    <!-- Glass card: new this round, floats over the photo on the side the
         copy doesn't occupy. Frosted (backdrop-filter), not a solid card
         like anything else on the page — a different material language,
         not a re-skin of the old bottom-left badge. -->
    <div class="hero-glass" aria-hidden="true">
      <span class="hero-glass-icon"><Icon name="heart" size={20} /></span>
      <p class="hero-glass-title">No seu ritmo</p>
      <p class="hero-glass-text">Sem pressa, sem comparação. Cada treino no tempo que faz sentido pra você.</p>
    </div>
  </div>

  <button type="button" class="scroll-cue" data-scroll-cue aria-label="Ver mais">
    <span class="scroll-cue-dot"></span>
  </button>

  <svg class="hero-wave" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,70 C360,50 1080,110 1440,80 L1440,220 L0,220 Z" />
  </svg>
</section>
<script>
  // Subtle parallax: the background drifts a few px slower than the page as
  // you leave the Hero. Purely decorative (transform only, never touches
  // opacity/visibility), capped to a small range, skipped entirely under
  // prefers-reduced-motion.
  const bg = document.querySelector<HTMLElement>('[data-parallax]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (bg && !reduced) {
    let ticking = false;
    const update = () => {
      const max = 40;
      const shift = Math.min(window.scrollY * 0.08, max);
      bg.style.transform = `translateY(${shift}px)`;
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
  }

  // Scroll-cue: only makes sense on a full-height hero (there's a "next
  // screen" to point at). Click scrolls one viewport down; fades out once
  // the visitor has already scrolled, so it never lingers as clutter.
  const cue = document.querySelector<HTMLButtonElement>('[data-scroll-cue]');
  if (cue) {
    cue.addEventListener('click', () => {
      window.scrollTo({ top: window.innerHeight, behavior: reduced ? 'auto' : 'smooth' });
    });
    window.addEventListener(
      'scroll',
      () => {
        cue.classList.toggle('is-hidden', window.scrollY > 80);
      },
      { passive: true }
    );
  }
</script>
<style>
  .hero-section {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    /* Fills the screen below the sticky nav (76px) plus a bit more — an
       exact one-viewport match still felt short once the wave's own
       height ate into the visible bottom of it, so this deliberately
       overshoots by 80px. svh (not vh) avoids the classic mobile
       browser-chrome jump; vh is the fallback for browsers without it. */
    min-height: calc(100vh - 76px + 80px);
    min-height: calc(100svh - 76px + 80px);
    padding-block: var(--space-6) calc(var(--space-6) + 130px);
  }
  @media (min-width: 860px) {
    .hero-section {
      padding-block: var(--space-6) calc(var(--space-6) + 190px);
    }
  }
  .hero-bg {
    /* Overscanned beyond the section's own edges so the blur filter's soft
       fringe never shows a hard boundary against the scrim. */
    position: absolute;
    inset: -15px;
    z-index: 0;
  }
  .hero-bg-img {
    /* Landscape source (3:2) means a much gentler crop than a portrait
       photo would need — only a light blur, for depth/legibility rather
       than to hide an awkward tight crop. */
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: blur(4px) saturate(1.05);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bg-img {
      animation: hero-bg-kenburns 24s ease-in-out infinite alternate;
    }
  }
  @keyframes hero-bg-kenburns {
    0% { transform: scale(1); }
    100% { transform: scale(1.08); }
  }
  .hero-scrim {
    /* Dark forest wash so white text stays legible over the photo at every
       point, slightly heavier at the bottom where it meets the wave. */
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-forest) 72%, transparent) 0%,
      color-mix(in srgb, var(--color-forest) 82%, transparent) 100%
    );
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
    width: 100%;
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
  .hero-copy {
    max-width: 34rem;
    color: var(--color-bg);
  }
  .hero-eyebrow {
    color: color-mix(in srgb, var(--color-accent) 75%, white 25%);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9rem;
  }
  .hero-section h1 {
    /* Local override: tokens.css's global h1 clamp (up to 4.75rem) wraps
       this exact headline to 3 lines at desktop widths inside a narrow
       column, failing the 2-line hero headline rule. Same font/weight,
       lower ceiling. */
    font-size: clamp(2rem, 1.2rem + 2.6vw, 3.1rem);
    margin-top: var(--space-2);
    color: var(--color-bg);
  }
  .hero-sub {
    color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    margin-top: var(--space-3);
    max-width: 44ch;
  }
  .hero-cta {
    margin-top: var(--space-4);
  }
  .accent-highlight {
    position: relative;
    display: inline-block;
  }
  .accent-highlight-text {
    position: relative;
    z-index: 1;
  }
  .hero-accent-bar {
    /* Left edge hugs the word's own box (no bleed into the preceding word
       space, which visually merged "a" + "você" into "avocê"). Right edge
       keeps a small bleed since it's followed by punctuation, not a space. */
    position: absolute;
    left: 0.02em;
    right: -0.08em;
    bottom: 0.06em;
    height: 0.4em;
    background: var(--color-accent);
    border-radius: 2px;
    transform: rotate(-1.5deg) scaleX(1);
    z-index: 0;
  }

  .hero-glass {
    display: none;
  }
  @media (min-width: 960px) {
    .hero-glass {
      display: block;
      width: 15rem;
      padding: var(--space-4);
      border-radius: var(--radius-md);
      background: color-mix(in srgb, white 14%, transparent);
      border: 1px solid color-mix(in srgb, white 25%, transparent);
      backdrop-filter: blur(16px) saturate(1.2);
      -webkit-backdrop-filter: blur(16px) saturate(1.2);
      color: var(--color-bg);
      box-shadow: 0 16px 40px -16px rgb(0 0 0 / 0.4);
    }
  }
  @media (min-width: 960px) and (prefers-reduced-motion: no-preference) {
    /* Real bug caught before shipping: this card originally also carried
       an `.enter` mount-animation class. `.enter`'s own fade-in relies on
       its `animation: enter-fade ...` declaration to move the element from
       its hidden base state (opacity:0) to visible — but the `animation`
       property doesn't merge across two separate rules, so this float
       declaration silently replaced enter-fade entirely, and the card sat
       at opacity:0 forever (confirmed via computed style, not just
       visually assumed). Fix: this element skips the `.enter` stagger and
       is visible immediately, with only this continuous float. */
    .hero-glass {
      animation: hero-glass-float 7s ease-in-out infinite;
    }
  }
  @keyframes hero-glass-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .hero-glass-icon {
    display: inline-flex;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .hero-glass-title {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .hero-glass-text {
    margin-top: var(--space-1);
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-bg) 85%, transparent);
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: calc(190px + var(--space-4));
    transform: translateX(-50%);
    z-index: 3;
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    width: 28px;
    height: 44px;
    padding: 6px 0;
    border-radius: 999px;
    border: 2px solid color-mix(in srgb, var(--color-bg) 70%, transparent);
    background: transparent;
    cursor: pointer;
    transition: opacity 200ms var(--ease-out, ease-out);
  }
  .scroll-cue.is-hidden {
    opacity: 0;
    pointer-events: none;
  }
  @media (max-width: 859px) {
    .scroll-cue {
      bottom: calc(130px + var(--space-3));
    }
  }
  .scroll-cue-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-bg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue-dot {
      animation: scroll-cue-drop 1.8s ease-in-out infinite;
    }
  }
  @keyframes scroll-cue-drop {
    0% { transform: translateY(0); opacity: 1; }
    70% { opacity: 1; }
    100% { transform: translateY(14px); opacity: 0; }
  }

  .hero-wave {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    width: 100%;
    height: 130px;
    z-index: 3;
    pointer-events: none;
  }
  @media (min-width: 860px) {
    .hero-wave {
      height: 190px;
    }
  }
  .hero-wave path {
    fill: var(--color-sage);
  }
</style>
