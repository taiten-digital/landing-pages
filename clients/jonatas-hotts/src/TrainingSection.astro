---
import { Image } from 'astro:assets';
import treino2 from '../assets/images/jonatas-treino-2.jpg';
import treino3 from '../assets/images/jonatas-treino-3.jpg';

// Two real photos of Jonatas mid-exercise, sourced from his own public
// Instagram (instagram.com/jhotts, technique-demo clips) and cropped with
// sharp to remove each clip's own burned-in caption. Presented as an
// overlapping, clickable photo stack (client feedback: this section read
// too similar to OfferSection - both were "heading + paragraph + generic
// card(s)"). Clicking sends the front photo to the back, a tactile
// "flip through" instead of a passive side-by-side list.
const photos = [
  { src: treino2, alt: 'Jonatas Hotts acompanhando de perto o exercício de uma aluna', caption: 'acompanha de perto', duration: '4.6s', delay: '0s', photoDuration: '5.8s', photoDelay: '0.9s' },
  { src: treino3, alt: 'Jonatas Hotts executando um supino na academia', caption: 'direto ao ponto', duration: '5.2s', delay: '0.3s', photoDuration: '6.6s', photoDelay: '1.6s' },
];
---
<section class="training-section" id="treino">
  <div class="training-inner">
    <div class="training-copy">
      <h2 class="enter enter-1">Como é treinar com o Jonatas</h2>
      <p class="enter enter-2">
        Sem papo de "academia intimidadora". O Jonatas corrige a sua postura,
        ajusta a pegada, explica por que aquele exercício está doendo no lugar
        errado, tudo na hora, sem enrolação.
      </p>
      <p class="enter enter-3">
        Se você é sedentário há um tempo, enjoou da rotina ou nem sabe por onde
        começar, o treino é montado a partir disso: ajustado ao que você
        consegue fazer hoje, não ao que um atleta faria.
      </p>
      <p class="enter enter-4">
        <a href="https://instagram.com/jhotts" target="_blank" rel="noopener noreferrer" class="training-ig-link">Nos vídeos dele</a>, dá pra ver esse jeito de ensinar na prática: correção
        de postura, dica de execução, direto ao ponto.
      </p>
    </div>

    <!--
      Each effect gets its own node (root CLAUDE.md's animation-conflict
      rule, extended here to a third effect): .training-photo (outer) only
      mounts (.enter, one-shot); .stack-pos (new, middle) is the ONLY node
      the shuffle script touches (transform, transition-based, user-click
      driven); .training-photo-float (inner) is the only node with the
      continuous .idle-float. None of the three ever share an element.
    -->
    <div class="enter enter-5 photo-stack-wrap">
      <div class="photo-stack" data-photo-stack role="button" tabindex="0" aria-label="Ver mais fotos do treino">
        {photos.map((p) => (
          <div class="training-photo">
            <div class="stack-pos">
              <div class="training-photo-frame card-sticker">
                <div class="training-photo-float idle-float" style={`--float-duration:${p.photoDuration}; --float-delay:${p.photoDelay};`}>
                  <Image src={p.src} alt={p.alt} width={320} loading="lazy" class="training-photo-img" />
                </div>
              </div>
              <div class="training-caption card-sticker">
                <span
                  class="training-caption-inner idle-float"
                  style={`--float-duration:${p.duration}; --float-delay:${p.delay};`}
                >
                  {p.caption}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="stack-hint">toque nas fotos</p>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-photo-stack]').forEach((stack) => {
    const items = Array.from(stack.querySelectorAll<HTMLElement>('.training-photo'));
    if (items.length < 2) return;
    let order = items.map((_, i) => i); // order[0] = index (into items) of the front photo

    const apply = () => {
      order.forEach((itemIndex, pos) => {
        const posEl = items[itemIndex].querySelector<HTMLElement>('.stack-pos');
        if (!posEl) return;
        items[itemIndex].style.zIndex = String(items.length - pos);
        const offset = pos * 14;
        const rotate = pos === 0 ? '0deg' : itemIndex % 2 === 0 ? '-4deg' : '4deg';
        posEl.style.transform = `translate(${offset}px, ${offset}px) rotate(${rotate})`;
      });
    };
    const shuffle = () => {
      order = [...order.slice(1), order[0]];
      apply();
    };
    stack.addEventListener('click', shuffle);
    stack.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        shuffle();
      }
    });
    apply();
  });
</script>
<style>
  .training-section {
    background: var(--color-sand);
    padding-block: var(--space-6);
  }
  .training-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .training-inner {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: center;
    }
  }
  .training-copy {
    max-width: 56ch;
  }
  .training-copy p {
    margin-top: var(--space-3);
    color: var(--color-fg);
  }
  .training-ig-link {
    color: var(--color-energy-deep);
    text-decoration: underline;
    text-underline-offset: 0.15em;
    transition: color 160ms var(--ease-out);
  }
  .training-ig-link:hover {
    color: var(--color-charcoal);
  }

  .photo-stack-wrap {
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .photo-stack-wrap {
      margin-inline: 0;
      margin-left: auto;
      width: fit-content;
    }
  }
  .photo-stack {
    position: relative;
    width: 9.5rem;
    height: calc(9.5rem * 5 / 4 + 20px);
    cursor: pointer;
  }
  @media (min-width: 900px) {
    .photo-stack {
      width: 11rem;
      height: calc(11rem * 5 / 4 + 20px);
    }
  }
  .stack-hint {
    margin-top: var(--space-2);
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .training-photo {
    position: absolute;
    inset: 0;
  }
  .stack-pos {
    width: 100%;
    transition: transform 380ms var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-pos {
      transition: none;
    }
  }
  .training-photo-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    aspect-ratio: 4 / 5;
  }
  /* Larger than the frame (inset: -10px) so the idle-float bob/rotate
     doesn't reveal the frame's edge - overflow:hidden above clips it. */
  .training-photo-float {
    position: absolute;
    inset: -10px;
  }
  .training-photo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .training-caption {
    position: absolute;
    bottom: -0.6rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.35em 0.9em;
    width: max-content;
  }
  /* Combined selector, not `.training-caption` alone: `.card-sticker`'s
     own background rule lives in tokens.css, which is always inlined last
     in document order, so a same-specificity single-class rule here would
     lose the cascade tie (the exact bug QA caught once already on this
     client — see root CLAUDE.md's Common CSS Pitfalls). */
  .training-caption.card-sticker {
    background: var(--color-charcoal);
  }
  .training-caption-inner {
    display: inline-block;
    font-weight: 800;
    font-family: var(--font-display);
    font-size: 0.85rem;
    text-transform: lowercase;
    color: var(--color-bg);
  }
</style>
