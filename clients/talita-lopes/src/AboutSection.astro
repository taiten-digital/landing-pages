---
import Icon from '../../../shared/components/Icon.astro';

// Rebuilt from zero (not a re-skin of the old photo+bullet-list layout):
// a before/after contrast module. Every line on both sides restates a fact
// already established elsewhere on this page (the Hero's objection-hooks,
// the FAQ's own answers) — nothing new is claimed, it's just dramatized as
// a visible comparison instead of prose.
const before = [
  'Treino genérico, igual pra todo mundo',
  'Ninguém pergunta sua história antes',
  'Dor que nunca foi realmente ouvida',
];
const after = [
  'Avaliação física antes de qualquer treino',
  'Prescrição que parte do seu histórico',
  'Ritmo e limitações sempre respeitados',
];
const credentials = [
  'Educação Física (UNOPAR)',
  'CREF 019973-G/PR',
  'Especialista em coluna vertebral',
  '+10 anos em Londrina/PR',
];
---
<section class="about-section" id="sobre">
  <div class="about-inner">
    <div class="about-header">
      <h2>Sobre a Talita</h2>
      <p class="about-lead">Ela <span class="lead-accent">ouve</span> antes de prescrever.</p>
    </div>

    <div class="contrast">
      <div class="contrast-panel contrast-before" data-hover-lift>
        <span class="contrast-label">Sem o acompanhamento certo</span>
        <ul>
          {before.map((item) => (
            <li><Icon name="close" size={13} strokeWidth={3} /><span>{item}</span></li>
          ))}
        </ul>
      </div>
      <div class="contrast-arrow" aria-hidden="true">
        <Icon name="chevron-right" size={20} strokeWidth={2.5} />
      </div>
      <div class="contrast-panel contrast-after" data-hover-lift>
        <span class="contrast-label">Com a Talita</span>
        <ul>
          {after.map((item) => (
            <li><Icon name="check" size={13} strokeWidth={3} /><span>{item}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="about-proof">
      <p class="about-body">
        Antes de montar qualquer treino, a Talita quer entender sua história: o que você já
        tentou, o que doeu, o que funcionou e o que não funcionou. Por isso o treino se
        adapta a você — nunca uma planilha pronta igual para todo mundo.
      </p>
      <ul class="about-credentials">
        {credentials.map((item) => (
          <li><Icon name="check" size={12} strokeWidth={3} />{item}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .about-section {
    /* Asymmetric: the Hero's wave already carries visual movement into
       this section, so a full --space-6 (80px) on top of that read as an
       empty band before any content. First cut (--space-5, 48px) still
       read as too much — cut further to --space-4 (32px). Bottom keeps
       the fuller space to match the next section's rhythm. */
    background: var(--color-sage);
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }
  .about-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .about-header {
    text-align: center;
    max-width: 32rem;
    margin-inline: auto;
  }
  .about-lead {
    font-family: var(--font-display, inherit);
    font-weight: 800;
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.1rem);
    margin-top: var(--space-2);
    color: var(--color-forest);
  }
  .lead-accent {
    background: linear-gradient(100deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 55%, var(--color-forest)));
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }

  /* Contrast module: the section's new structural core. */
  .contrast {
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    justify-items: center;
    max-width: 54rem;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .contrast {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--space-4);
    }
  }
  .contrast-panel {
    width: 100%;
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .contrast-panel ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .contrast-panel li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.95rem;
  }
  .contrast-label {
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .contrast-before {
    background: color-mix(in srgb, var(--color-forest) 5%, white);
    border: 1px dashed color-mix(in srgb, var(--color-forest) 30%, transparent);
    color: color-mix(in srgb, var(--color-forest) 70%, transparent);
  }
  .contrast-before .contrast-label {
    color: color-mix(in srgb, var(--color-forest) 55%, transparent);
  }
  .contrast-before li {
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--color-forest) 35%, transparent);
    opacity: 0.8;
  }
  .contrast-before li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: color-mix(in srgb, var(--color-forest) 45%, transparent);
  }
  .contrast-after {
    /* Compensates for the photo's removed idle float: a slow diagonal
       light sweep across the "winning" panel keeps this module carrying
       continuous motion, not just the arrow's pulse. */
    position: relative;
    overflow: hidden;
    background: var(--color-forest);
    color: var(--color-bg);
    box-shadow: 0 16px 32px -16px color-mix(in srgb, var(--color-forest) 60%, transparent);
  }
  .contrast-after::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      115deg,
      transparent 40%,
      color-mix(in srgb, var(--color-accent) 22%, transparent) 50%,
      transparent 60%
    );
    transform: translateX(-100%);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .contrast-after::before {
      animation: contrast-shimmer 5s ease-in-out infinite;
    }
  }
  @keyframes contrast-shimmer {
    0%, 20% { transform: translateX(-100%); }
    55%, 100% { transform: translateX(100%); }
  }
  .contrast-after .contrast-label,
  .contrast-after ul {
    position: relative;
    z-index: 1;
  }
  .contrast-after .contrast-label {
    color: color-mix(in srgb, var(--color-accent) 80%, white);
  }
  .contrast-after li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--color-accent);
  }
  .contrast-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-fg);
    transform: rotate(90deg);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-accent) 16%, transparent);
  }
  @media (min-width: 768px) {
    .contrast-arrow {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .contrast-arrow {
      animation: contrast-arrow-pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes contrast-arrow-pulse {
    0%, 100% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-accent) 16%, transparent); }
    50% { box-shadow: 0 0 0 11px color-mix(in srgb, var(--color-accent) 6%, transparent); }
  }

  /* Compact proof strip: body + credentials, no longer the whole section's
     layout, just a supporting line underneath the contrast. No photo here
     (removed per client feedback) — its continuous motion was moved onto
     the contrast module itself (see the shimmer sweep on .contrast-after
     above), so removing it doesn't leave the section any more static. */
  .about-proof {
    margin-top: var(--space-6);
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }
  .about-body {
    color: var(--color-muted);
  }
  .about-credentials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
  .about-credentials li {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35em 0.8em;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-forest) 8%, transparent);
    color: var(--color-forest);
  }
  .about-credentials :global(svg) {
    color: var(--color-accent);
  }
</style>
